# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.open-next/
/.wrangler/

# misc
.DS_Store
*.pem
*.dmg
*.dmg.sha256

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local

# local ESP32 credentials
hardware/**/config.h

# local hardware demo data
/.data/

# generated local verification artifacts
/.arduino-build/
/tmp/
**/__pycache__/
*.py[cod]

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Xcode
DerivedData/
xcuserdata/
*.xcuserstate
*.xcarchive
*.ipa

# Local agent working files
/.workbuddy/
/CODEX_CAREGIVER_APP_HANDOFF.md

# local duplicate backups
/README 2.md
/app/page 2.tsx

# Pilot local secrets and generated test output
/.pilot-secrets/
/.test-build/
/wrangler.pilot.local.jsonc
