{
  "name": "smart-pillbox-ai-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo:hardware": "bash scripts/start-hardware-demo.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node scripts/test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run test && npm run typecheck",
    "pilot:credentials": "node scripts/pilot-credentials.mjs",
    "pilot:dev": "node scripts/pilot-dev.mjs",
    "pilot:migrate:local": "wrangler d1 migrations apply PILOT_DB --local --config wrangler.pilot.local.jsonc"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.118.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
